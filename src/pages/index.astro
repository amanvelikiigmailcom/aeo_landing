---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'AEW Agency — AI Automation & ChatGPT Top Ranking',
  ignoreTitleTemplate: true,
};
---

<script>
  if (window.location.pathname === '/' && navigator.language && navigator.language.startsWith('ru')) {
    window.location.replace('/ru');
  }
</script>

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Book a free consultation',
        href: 'https://cal.com/example',
        target: '_blank',
        icon: 'tabler:calendar',
      },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'AEW Agency Hero Image' }}
  >
    <Fragment slot="title"> AEW Agency: AI Automation & ChatGPT Ranking </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Dent</span> the universe with our top-tier AI services. We help you rank on ChatGPT and
        automate your business processes.
      </span>
    </Fragment>
  </Hero>

  <!-- Features Widget *************** -->
  <Features
    id="features"
    tagline="Features"
    title="What you get with AEW Agency"
    subtitle="Best practices for modern AI businesses."
    items={[
      {
        title: 'ChatGPT Top Ranking',
        description:
          'Get your products and services recommended by ChatGPT. We use advanced prompt engineering and SEO strategies for LLMs.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'AI Automation',
        description:
          'Automate your workflows and reduce costs. From customer support chatbots to complex data processing pipelines.',
        icon: 'tabler:components',
      },
      {
        title: 'Expert Consultation',
        description: 'Book a free consultation to see how we can transform your business with AI. Dent the universe!',
        icon: 'tabler:list-check',
      },
      {
        title: 'Excellent Page Speed',
        description:
          'Having a good page speed impacts organic search ranking, improves user experience (UI/UX) and increase conversion rates.',
        icon: 'tabler:rocket',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->
  <Stats
    stats={[
      { title: 'Clients', amount: '132+' },
      { title: 'Projects', amount: '248+' },
      { title: 'Automations', amount: '10K+' },
      { title: 'ROI', amount: '300%' },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Book a free consultation',
        href: 'https://cal.com/example',
        target: '_blank',
        icon: 'tabler:calendar',
      },
    ]}
  >
    <Fragment slot="title"> Ready to transform your business? </Fragment>

    <Fragment slot="subtitle">
      Book a free consultation today and let's discuss how we can help you achieve your goals with AI.
    </Fragment>
  </CallToAction>
</Layout>
