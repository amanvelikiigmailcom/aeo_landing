---
import Layout from '~/layouts/PageLayoutRu.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'AEW Agency — AI Автоматизация & Топ Рейтинг в ChatGPT',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Записаться на бесплатную консультацию',
        href: 'https://cal.com/example',
        target: '_blank',
        icon: 'tabler:calendar',
      },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'AEW Agency Hero Image' }}
  >
    <Fragment slot="title"> AEW Agency: AI Автоматизация & Рейтинг в ChatGPT </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Dent</span> (оставьте след) во вселенной с нашими передовыми AI услугами. Мы помогаем
        вам занимать топовые позиции в ChatGPT и автоматизировать бизнес-процессы.
      </span>
    </Fragment>
  </Hero>

  <!-- Features Widget *************** -->
  <Features
    id="features"
    tagline="Особенности"
    title="Что вы получаете с AEW Agency"
    subtitle="Лучшие практики для современного AI бизнеса."
    items={[
      {
        title: 'Топ Рейтинг в ChatGPT',
        description:
          'Сделайте так, чтобы ChatGPT рекомендовал ваши продукты и услуги. Мы используем передовой prompt engineering и SEO стратегии для LLM.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'AI Автоматизация',
        description:
          'Автоматизируйте свои рабочие процессы и сократите расходы. От чат-ботов поддержки клиентов до сложных пайплайнов обработки данных.',
        icon: 'tabler:components',
      },
      {
        title: 'Экспертная Консультация',
        description:
          'Запишитесь на бесплатную консультацию, чтобы узнать, как мы можем трансформировать ваш бизнес с помощью AI. Оставьте свой след (Dent)!',
        icon: 'tabler:list-check',
      },
      {
        title: 'Высокая Скорость Страниц',
        description:
          'Высокая скорость загрузки страниц влияет на органическое ранжирование, улучшает пользовательский опыт (UI/UX) и повышает конверсию.',
        icon: 'tabler:rocket',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->
  <Stats
    stats={[
      { title: 'Клиенты', amount: '132+' },
      { title: 'Проекты', amount: '248+' },
      { title: 'Автоматизации', amount: '10K+' },
      { title: 'ROI', amount: '300%' },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Записаться на бесплатную консультацию',
        href: 'https://cal.com/example',
        target: '_blank',
        icon: 'tabler:calendar',
      },
    ]}
  >
    <Fragment slot="title"> Готовы трансформировать ваш бизнес? </Fragment>

    <Fragment slot="subtitle">
      Запишитесь на бесплатную консультацию сегодня и давайте обсудим, как мы можем помочь вам достичь ваших целей с
      помощью AI.
    </Fragment>
  </CallToAction>
</Layout>
