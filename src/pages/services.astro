---
import Layout from '~/layouts/PageLayout.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Services | AEW Agency',
};
---

<Layout metadata={metadata}>
  <Features2
    title="Our Services"
    subtitle="Comprehensive AI solutions to elevate your business."
    items={[
      {
        title: 'ChatGPT & LLM Optimization',
        description:
          'Ensure your business is recommended by ChatGPT and other LLMs through strategic prompt engineering and content optimization.',
        icon: 'tabler:brain',
      },
      {
        title: 'Custom AI Agents',
        description:
          'Deploy autonomous agents tailored to handle your specific business logic, from customer support to complex data analysis.',
        icon: 'tabler:robot',
      },
      {
        title: 'Process Automation',
        description:
          'Streamline your operations. We build pipelines that connect your tools and automate repetitive tasks using AI.',
        icon: 'tabler:infinity',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Book a free consultation',
        href: 'https://cal.com/example',
        target: '_blank',
        icon: 'tabler:calendar',
      },
    ]}
  >
    <Fragment slot="title"> Ready to automate? </Fragment>
    <Fragment slot="subtitle"> Book a free consultation to see how we can make a dent in your industry. </Fragment>
  </CallToAction>
</Layout>
